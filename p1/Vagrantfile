# -*- mode: ruby -*-

# ------------------------------------------------------------------
# Vagrantfile for configuring virtual machine infrastructure using Vagrant
#
# This file uses Vagrant configuration API version 2, which is the current standard
# for defining Vagrant environments. API version 2 provides support for:
# - Multiple provider backends (VirtualBox, VMware, AWS, etc.)
# - Multiple virtual machines in a single configuration
# - Improved syntax and configuration options compared to API version 1
# - Better provisioning and networking capabilities
#
# The version 2 API is specified by passing "2" to Vagrant.configure()
# ------------------------------------------------------------------



# ---------------------------------------------------------
# ------------------- Bring-up Ordering -------------------
# ---------------------------------------------------------

# The worker can only join a control plane that is already serving its API, so
# the two machines have to be created one after the other: the server first,
# the worker second (that is the order they are defined in below).
#
# `vagrant up` decides whether to run the machines in parallel at the moment it
# builds its batch action, and it drops parallelism when VAGRANT_NO_PARALLEL is
# set in the environment. The Vagrantfile is evaluated before that decision is
# made, so setting it here gives a plain `vagrant up` the same behaviour as
# `vagrant up --no-parallel`, without anyone having to remember the flag. It can
# only ever remove parallelism, never add it, so a provider that already runs
# serially is unaffected.
ENV['VAGRANT_NO_PARALLEL'] = 'yes'


# ---------------------------------------------------------
# ----------------- Configuration Flags -------------------
# ---------------------------------------------------------

BOX = ENV['VAGRANT_DEFAULT_BOX'] || "generic/ubuntu2204"  # Base box for the virtual machines
SERVER = "youmoukhS"  # Name of the server VM
WORKER = "youmoukhSW"  # Name of the worker
SERVER_IP = "192.168.56.110"
WORKER_IP = "192.168.56.111"
MEMORY = 1024  # Memory allocation for each VM in MB
CPUS = 1  # Number of CPU cores for each VM
VIRTIO_NIC = "virtio"  # Network interface type for VirtualBox provider


# ---------------------------------------------------------
# ---------------- VagrantConfiguration  ------------------
# ---------------------------------------------------------

# Configure Vagrant with version 2 API
Vagrant.configure("2") do |config|
  config.vm.box = BOX
  # Nested virtualization adds overhead to boot time, so give SSH more time
  # to come up than the 300s default before Vagrant gives up.
  config.vm.boot_timeout = 600

  # Shared secret used by both nodes to join the same K3s cluster. Fixing it
  # here means the worker doesn't have to wait on the synced folder to see a
  # token generated by the server.
  k3s_token = "iot-k3s-cluster-token"

  # ------------------------------------------------------------------
  # SERVER Configuration (S)
  # ------------------------------------------------------------------
  
  config.vm.define SERVER do |s|
    s.vm.hostname = SERVER
    s.vm.network "private_network", ip: SERVER_IP

    s.vm.provider "virtualbox" do |vb|
      # ------------------------------------------------------------------
      # The subject's "1 CPU / 512MB (or 1024)" guidance was sized for the
      # k3s release in its own screenshots (v1.21.4, ~2021). Use the maximum
      # memory permitted by the subject for the server.
      # ------------------------------------------------------------------
      vb.memory = MEMORY
      vb.cpus = CPUS
      vb.customize ["modifyvm", :id, "--nictype1", VIRTIO_NIC, "--nictype2", VIRTIO_NIC ]
    end

    s.vm.provider "libvirt" do |libvirt|
      libvirt.driver = "qemu" unless File.exist?("/dev/kvm")
      libvirt.memory = MEMORY
      libvirt.cpus = CPUS
    end

    s.vm.provision "shell", path: "scripts/setup_server.sh", env: { "K3S_TOKEN" => k3s_token }
  end


  # ------------------------------------------------------------------
  # WORKER Configuration (SW)
  # ------------------------------------------------------------------

  config.vm.define WORKER do |sw|
    sw.vm.hostname = WORKER
    sw.vm.network "private_network", ip: WORKER_IP

    sw.vm.provider "virtualbox" do |vb|
      vb.memory = MEMORY
      vb.cpus = CPUS
      vb.customize ["modifyvm", :id, "--nictype1", VIRTIO_NIC, "--nictype2", VIRTIO_NIC ]
    end

    sw.vm.provider "libvirt" do |libvirt|
      libvirt.driver = "qemu" unless File.exist?("/dev/kvm")
      libvirt.memory = MEMORY
      libvirt.cpus = CPUS
    end

    sw.vm.provision "shell", path: "scripts/setup_worker.sh", env: { "K3S_TOKEN" => k3s_token }
  end
end